{
  "source": [
    "tokens/primitives.json",
    "tokens/typography.json",
    "tokens/elevation.json",
    "tokens/states.json",
    "tokens/motion.json",
    "tokens/icons.json",
    "tokens/semantic.json"
  ],
  "platforms": {
    "css-light": {
      "transformGroup": "css",
      "buildPath": "styles/",
      "files": [
        {
          "destination": "tokens.css",
          "format": "css/variables",
          "options": { "selector": ":root, [data-theme='light']" }
        }
      ]
    },
    "css-dark": {
      "source": [
        "tokens/primitives.json",
        "tokens/themes/dark.json"
      ],
      "transformGroup": "css",
      "buildPath": "styles/",
      "files": [
        {
          "destination": "tokens-dark.css",
          "format": "css/variables",
          "options": { "selector": "[data-theme='dark']" }
        }
      ]
    },
    "css-direction-a": {
      "source": [
        "tokens/primitives.json",
        "tokens/themes/direction-a.json"
      ],
      "transformGroup": "css",
      "buildPath": "styles/",
      "files": [
        {
          "destination": "tokens-direction-a.css",
          "format": "css/variables",
          "options": { "selector": "[data-brand='a']" }
        }
      ]
    },
    "css-direction-b": {
      "source": [
        "tokens/primitives.json",
        "tokens/themes/direction-b.json"
      ],
      "transformGroup": "css",
      "buildPath": "styles/",
      "files": [
        {
          "destination": "tokens-direction-b.css",
          "format": "css/variables",
          "options": { "selector": "[data-brand='b']" }
        }
      ]
    },
    "css-direction-c": {
      "source": [
        "tokens/primitives.json",
        "tokens/themes/direction-c.json"
      ],
      "transformGroup": "css",
      "buildPath": "styles/",
      "files": [
        {
          "destination": "tokens-direction-c.css",
          "format": "css/variables",
          "options": { "selector": "[data-brand='c']" }
        }
      ]
    }
  }
}
