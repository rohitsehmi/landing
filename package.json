{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:a11y": "eslint . --ext .ts,.tsx --rule 'jsx-a11y/recommended: error'",
    "type-check": "tsc --noEmit",
    "tokens:build": "style-dictionary build --config sd.config.json",
    "tokens:watch": "style-dictionary build --config sd.config.json --watch",
    "db:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/supabase.ts",
    "check": "npm run type-check && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@upstash/ratelimit": "latest",
    "@upstash/redis": "latest",
    "@vercel/analytics": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "latest",
    "@react-email/components": "latest",
    "resend": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "@vercel/edge-config": "latest"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "^15.3.0",
    "eslint-config-prettier": "latest",
    "eslint-plugin-jsx-a11y": "latest",
    "prettier": "latest",
    "style-dictionary": "^4",
    "tailwindcss": "^3",
    "typescript": "^5",
    "axe-core": "latest",
    "vitest": "latest",
    "@vitest/coverage-v8": "latest",
    "@playwright/test": "latest",
    "axe-playwright": "latest",
    "@testing-library/react": "latest",
    "@testing-library/jest-dom": "latest",
    "jsdom": "latest",
    "@next/bundle-analyzer": "latest"
  }
}