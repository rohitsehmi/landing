{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:a11y": "eslint . --ext .ts,.tsx --rule 'jsx-a11y/recommended: error'",
    "type-check": "tsc --noEmit",
    "tokens:build": "node sd.config.mjs",
    "tokens:watch": "node --watch sd.config.mjs",
    "db:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/supabase.ts",
    "check": "npm run type-check && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-slot": "latest",
    "@react-email/components": "latest",
    "@sentry/nextjs": "^10.45.0",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@upstash/ratelimit": "latest",
    "@upstash/redis": "latest",
    "@vercel/analytics": "latest",
    "@vercel/edge-config": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "latest",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "latest",
    "resend": "latest",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "latest",
    "axe-core": "latest",
    "axe-playwright": "latest",
    "eslint": "^8",
    "eslint-config-next": "^15.3.0",
    "eslint-config-prettier": "latest",
    "eslint-plugin-jsx-a11y": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "style-dictionary": "^4",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vitest": "latest"
  }
}
